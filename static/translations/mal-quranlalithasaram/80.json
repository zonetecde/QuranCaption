[
  {
    "id": 80,
    "city": "makkah",
    "name": {
      "translated": "He Frowned",
      "transliterated": "'Abasa",
      "codepoints": [
        1593,
        1576,
        1587
      ]
    },
    "ayahs": 42,
    "slug": "abasa",
    "translator": "Muhammad Karakunnu And Vanidas Elayavoor"
  },
  [
    1,
    "അവന്‍ മുഖം ചുളിച്ചു, തിരിഞ്ഞുകളയുകയും ചെയ്തു,"
  ],
  [
    2,
    "ആ കുരുടന്‍ അവന്റെ അടുക്കല്‍ വന്നതിന്ന്!"
  ],
  [
    3,
    "നിനക്കെന്തറിയാം? അവന്‍ (=ആ കുരുടന്‍) പരിശുദ്ധി പ്രാപിച്ചേക്കാമല്ലോ!"
  ],
  [
    4,
    "അല്ലെങ്കില്‍, അവന്‍ ഉപദേശം സ്വീകരിച്ചേക്കാം, എന്നിട്ട് ആ ഉപദേശം അവന്ന് ഉപകാരപ്പെടുകയും ചെയ്‌തേക്കാം."
  ],
  [
    5,
    "എന്നാല്‍, താന്‍ സ്വയം പര്യാപ്തനാണെന്ന് നടിച്ചവനാകട്ടെ,"
  ],
  [
    6,
    "അവന്ന് വേണ്ടി നീ തയ്യാറായിരിക്കയാണ്."
  ],
  [
    7,
    "അവന്‍ പരിശുദ്ധി പ്രാപിക്കാതിരിക്കുന്നതിന്ന് നിനക്ക് എന്ത് (കുറ്റം) ആണുള്ളത്?"
  ],
  [
    8,
    "എന്നാല്‍, നിന്റെ അടുത്ത് പാഞ്ഞുവന്നവനാകട്ടെ,"
  ],
  [
    9,
    "അവനാകട്ടെ, ഭയപ്പെടുന്ന നിലയിലാണ് താനും-"
  ],
  [
    10,
    "അവനെപ്പറ്റി നീ അശ്രദ്ധ കാണിക്കുന്നു!"
  ],
  [
    11,
    "അല്ലാ, നിശ്ചയമായും ഇത് ഒരു ഉപദേശമാണ്."
  ],
  [
    12,
    "അതുകൊണ്ട് ആര്‍ ഉദ്ദേശിക്കുന്നുവോ അവര്‍ അത് ഓര്‍ത്തുകൊള്ളട്ടെ,"
  ],
  [
    13,
    "ആദരണീയമായ ചില ഏടുകളില്‍ (ആണ് അതുള്ളത്);"
  ],
  [
    14,
    "(അതെ,) ഉന്നതമാക്കപ്പെട്ടതും പരിശുദ്ധമാക്കപ്പെട്ടതും,"
  ],
  [
    15,
    "ചില ദൗത്യവാഹകരുടെ കൈകളിലൂടെ,,"
  ],
  [
    16,
    "(അതെ) മാന്യന്മാരും പുണ്യവാന്മാരും ആയ (ചില ദൗത്യവാഹകരുടെ കൈകളിലൂടെ വന്ന ഏടുകളില്‍)."
  ],
  [
    17,
    "മനുഷ്യന്ന് നാശം! അവന്‍ എത്ര നന്ദികെട്ടവന്‍!"
  ],
  [
    18,
    "ഏതൊരു വസ്തുവില്‍ നിന്നാണ് അവന്‍ (=അല്ലാഹു) അവനെ (=മനുഷ്യനെ) സൃഷ്ടിച്ചിരിക്കുന്നത്?"
  ],
  [
    19,
    "ഒരു ഇന്ദ്രിയത്തുള്ളിയില്‍ നിന്ന് (തന്നെ); അവന്‍ (=അല്ലാഹു) അവനെ സൃഷ്ടിച്ചു; എന്നിട്ടവനെ കണക്കാക്കി വ്യവസ്ഥപ്പെടുത്തി,"
  ],
  [
    20,
    "പിന്നെ, അവന്റെ (വിജയത്തിന്നുള്ള) മാര്‍ഗ്ഗം അവന്ന് എളുപ്പമാക്കിക്കൊടുത്തു,"
  ],
  [
    21,
    "പിന്നെ, അവനെ മരിപ്പിക്കുകയും ഖബറടക്കുകയും ചെയ്തു;"
  ],
  [
    22,
    "പിന്നീട്, അവന്‍ ഉദ്ദേശിക്കുമ്പോള്‍ അവനെ (=മനുഷ്യനെ) ഉയിര്‍ത്തെഴുന്നേല്‍പ്പിക്കുകയും ചെയ്യുന്നു."
  ],
  [
    23,
    "അങ്ങനെയല്ലാ! അവനോട് (അല്ലാഹു) കല്‍പിച്ചത് അവന്‍ ചെയ്തിട്ടില്ല."
  ],
  [
    24,
    "എന്നാല്‍, മനുഷ്യന്‍ അവന്റെ ഭക്ഷണത്തിലേക്ക് (ഒന്നുതിരിഞ്ഞു) നോക്കട്ടെ,"
  ],
  [
    25,
    "നാം വെള്ളത്തെ ശക്തമായ നിലയില്‍ ചൊരിച്ചുകൊടുത്തു എന്നത്;"
  ],
  [
    26,
    "പിന്നീട് ഭൂമിയെ നാം നന്നായി പിളര്‍ത്തി (എന്നതും);"
  ],
  [
    27,
    "എന്നിട്ട് നാമതില്‍ ധാന്യം മുളപ്പിച്ചു (എന്നതും)"
  ],
  [
    28,
    "മുന്തിരിയും പച്ചക്കറിയും,"
  ],
  [
    29,
    "ഒലീവും ഈത്തപ്പനയും,"
  ],
  [
    30,
    "തിങ്ങിയ (=നിറഞ്ഞ) തോട്ടങ്ങളും,"
  ],
  [
    31,
    "പഴവും മേച്ചില്‍പുല്ലും,"
  ],
  [
    32,
    "നിങ്ങള്‍ക്കും നിങ്ങളുടെ കന്നുകാലികള്‍ക്കും ഉള്ള ഉപയോഗ സാധനങ്ങളായിക്കൊണ്ട് (നാം സൃഷ്ടിച്ചു എന്നതും)."
  ],
  [
    33,
    "എന്നാല്‍ ആ ചെകിടടക്കുന്ന ശബ്ദം വരുമ്പോള്‍,"
  ],
  [
    34,
    "(അതായത്) മനുഷ്യന്‍ തന്റെ സഹോദരനില്‍ നിന്നും ഓടിപ്പോകുന്ന ദിവസം,-"
  ],
  [
    35,
    "(മാത്രമല്ല) അവന്റെ മാതാവില്‍ നിന്നും അവന്റെ പിതാവില്‍ നിന്നും,"
  ],
  [
    36,
    "അവന്റെ കൂട്ടുകാരിയില്‍ നിന്നും മക്കളില്‍ നിന്നും;"
  ],
  [
    37,
    "അന്നേ ദിവസം അവരില്‍ ഓരോ മനുഷ്യന്നും (ഇതരനെ ശ്രദ്ധിക്കാനാവാത്ത വിധം) അവന്ന് മതിയാവോളം കാര്യമുണ്ടായിരിക്കും."
  ],
  [
    38,
    "അന്നേദിവസം, ചില മുഖങ്ങള്‍ തെളിഞ്ഞവയായിരിക്കും."
  ],
  [
    39,
    "ചിരിക്കുന്നവയും സന്തോഷം കൊള്ളുന്നവയുമായിരിക്കും;"
  ],
  [
    40,
    "ചില മുഖങ്ങളാകട്ടെ, അന്നേദിവസം അവയ്ക്ക് മീതെ പൊടി പുരണ്ടിരിക്കും;"
  ],
  [
    41,
    "അവയെ കൂരിരുട്ട് മൂടിയിരിക്കും."
  ],
  [
    42,
    "അക്കൂട്ടരാവട്ടെ, അവരാണ് മഹാപാപികളായ സത്യനിഷേധികള്‍."
  ]
]