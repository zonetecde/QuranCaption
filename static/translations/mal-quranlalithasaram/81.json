[
  {
    "id": 81,
    "city": "makkah",
    "name": {
      "translated": "The Overthrowing",
      "transliterated": "At-Takwir",
      "codepoints": [
        1575,
        1604,
        1578,
        1603,
        1608,
        1610,
        1585
      ]
    },
    "ayahs": 29,
    "slug": "at-takwir",
    "translator": "Muhammad Karakunnu And Vanidas Elayavoor"
  },
  [
    1,
    "സൂര്യന്‍ (ഇരുട്ടുകൊണ്ട്) ചുറ്റിമൂടപ്പെടുമ്പോള്‍,"
  ],
  [
    2,
    "നക്ഷത്രങ്ങള്‍ ഉതിര്‍ന്നു വീഴുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    3,
    "പര്‍വ്വതങ്ങള്‍ നടത്തപ്പെടുകയും ചെയ്യുമ്പോള്‍"
  ],
  [
    4,
    "പൂര്‍ണ്ണ ഗര്‍ഭിണികളായ ഒട്ടകങ്ങള്‍ കെട്ടഴിച്ചുവിടപ്പെടുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    5,
    "കാട്ടുജന്തുക്കള്‍ ഒരുമിച്ചു കൂട്ടപ്പെടുകയും ചെയ്യുമ്പോള്‍"
  ],
  [
    6,
    "സമുദ്രങ്ങള്‍ തിളച്ചുമറിക്കപ്പെടുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    7,
    "ആത്മാക്കള്‍ (ശരീരങ്ങളുമായി) ഇണക്കപ്പെടുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    8,
    "ജീവനോടെ കുഴിച്ചുമൂടപ്പെട്ട പെണ്‍കുട്ടി ചോദിക്കപ്പെടുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    9,
    "ഏതൊരു കുറ്റത്തിനാണ് അവള്‍ കൊല്ലപ്പെട്ടത് എന്ന്;"
  ],
  [
    10,
    "ഏടുകള്‍ നിവര്‍ത്തപ്പെടുകയും ചെയ്യുമ്പോള്‍;"
  ],
  [
    11,
    "ആകാശത്തിന്റെ മറ നീക്കപ്പെടുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    12,
    "നരകം ആളിക്കത്തിക്കപ്പെടുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    13,
    "സ്വര്‍ഗ്ഗം അടുത്തു കൊണ്ടുവരപ്പെടുകയും ചെയ്യുമ്പോള്‍,"
  ],
  [
    14,
    "ഏതൊരാളും താന്‍ ഹാജരാക്കിയത് (=നന്മ തിന്മകള്‍) എന്താണെന്ന് അറിയുന്നതാണ്."
  ],
  [
    15,
    "എന്നാല്‍ പിന്‍വാങ്ങിക്കൊണ്ടിരിക്കുന്നവയെക്കൊണ്ട് ഞാന്‍ സത്യം ചെയ്തു പറയേണ്ടതില്ല,-"
  ],
  [
    16,
    "(അതെ) സഞ്ചരിച്ചു മറഞ്ഞുപോകുന്നവയെക്കൊണ്ട്,"
  ],
  [
    17,
    "രാത്രി (ഇരുട്ടിലേക്ക്) മുന്നോട്ട് നീങ്ങുമ്പോള്‍, അതിനെക്കൊണ്ടും,"
  ],
  [
    18,
    "പ്രഭാതം വെളിപ്പെടുമ്പോള്‍ അതിനെക്കൊണ്ടും (സത്യം ചെയ്തു പറയേണ്ടതില്ല)."
  ],
  [
    19,
    "നിശ്ചയമായും ഇത് മാന്യനായ ഒരു ദൂതന്റെ വാക്കു തന്നെയാണ്,-"
  ],
  [
    20,
    "(അതെ) ശക്തിയുള്ളവനും സിംഹാസനത്തിന്റെ ഉടമയുടെ (=അല്ലാഹുവിന്റെ) അടുത്ത് സ്ഥാനമുള്ളവനുമായ (ദൂതന്റെ);"
  ],
  [
    21,
    "അവിടെ അനുസരിക്കപ്പെടുന്നവന്‍, വിശ്വസ്തന്‍ (അങ്ങനെയുള്ള ഒരു ദൂതന്റെ വാക്ക്)."
  ],
  [
    22,
    "നിങ്ങളുടെ ചങ്ങാതി (=ഈ നബി) ഒരു ഭ്രാന്തനൊന്നുമല്ല."
  ],
  [
    23,
    "തീര്‍ച്ചയായും അവനെ (=ജിബ്‌രീലിനെ) പ്രത്യക്ഷമായ ഉപരിമണ്ഡലത്തില്‍ വെച്ച് ഇവന്‍ (=ഈ നബി) കണ്ടിട്ടുണ്ട്."
  ],
  [
    24,
    "ഇവന്‍ അദൃശ്യമായതിനെ (=അദൃശ്യവാര്‍ത്തയെ)ക്കുറിച്ച് പിശുക്ക് കാണിക്കുന്നവനല്ല."
  ],
  [
    25,
    "ഇത് (=ഈ ഖുര്‍ആന്‍) ആട്ടപ്പെട്ട വല്ല പിശാചിന്റെ വാക്കുമല്ല,"
  ],
  [
    26,
    "അപ്പോള്‍ (ഇതിനെവിട്ട്) നിങ്ങള്‍ എവിടേക്കാണ് പോകുന്നത്."
  ],
  [
    27,
    "ഇത് ലോകങ്ങള്‍ക്കു (=ലോകര്‍ക്ക്) ഉള്ള ഒരു ഉപദേശമല്ലാതെ മറ്റൊന്നുമല്ല;"
  ],
  [
    28,
    "(അതെ) നിങ്ങളില്‍ നിന്നും ചൊവ്വായ വഴിക്ക് ചരിക്കാനുദ്ദേശിക്കുന്നവര്‍ക്ക് (ഉള്ള ഉപദേശം);"
  ],
  [
    29,
    "ലോകങ്ങളുടെ റബ്ബായ അല്ലാഹു ഉദ്ദേശിച്ചാലല്ലാതെ (=അവന്റെ നിയമത്തിനനുസൃതമായിട്ടല്ലാതെ) നിങ്ങള്‍ ഉദ്ദേശിക്കുന്നതല്ല താനും,"
  ]
]