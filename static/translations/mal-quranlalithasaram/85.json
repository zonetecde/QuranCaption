[
  {
    "id": 85,
    "city": "makkah",
    "name": {
      "translated": "The Mansions of the Stars",
      "transliterated": "Al-Buruj",
      "codepoints": [
        1575,
        1604,
        1576,
        1585,
        1608,
        1580
      ]
    },
    "ayahs": 22,
    "slug": "al-buruj",
    "translator": "Muhammad Karakunnu And Vanidas Elayavoor"
  },
  [
    1,
    "ഗ്രഹമണ്ഡലങ്ങളുള്ള ആകാശത്തെ കൊണ്ട് സത്യം,"
  ],
  [
    2,
    "വാഗ്ദത്തം ചെയ്യപ്പെട്ട ദിവസത്തെ കൊണ്ടും സത്യം,"
  ],
  [
    3,
    "സാക്ഷിയെക്കൊണ്ടും സാക്ഷീകരിക്കപ്പെടുന്നതിനെക്കൊണ്ടും സത്യം."
  ],
  [
    4,
    "കിടങ്ങിന്റെ ആള്‍ക്കാര്‍ നശിക്കട്ടെ!"
  ],
  [
    5,
    "(അതായത്) വിറക് നിറച്ച അഗ്നിയുടെ (=അഗ്നികുണ്ഠത്തിന്റെ ആള്‍ക്കാര്‍),"
  ],
  [
    6,
    "അവര്‍ അതിന്നടുത്ത് ഇരിക്കുന്നതായ സന്ദര്‍ഭം,"
  ],
  [
    7,
    "സത്യവിശ്വാസികളെക്കൊണ്ട് തങ്ങള്‍ ചെയ്യുന്നതിന്ന് അവര്‍ സാക്ഷികളായിക്കൊണ്ട്."
  ],
  [
    8,
    "പ്രതാപശാലിയും സ്തുത്യര്‍ഹനും ആയ അല്ലാഹുവില്‍ ഇവര്‍ വിശ്വസിക്കുന്നതല്ലാതെ മറ്റൊരു കുറ്റവും ഇവരുടെ മേല്‍ അവര്‍ ചുമത്തിയിട്ടില്ല,"
  ],
  [
    9,
    "(അതെ,) ആകാശങ്ങളുടെയും ഭൂമിയുടെയും രാജാധിപത്യം ഉള്ളവനായ (അല്ലാഹുവില്‍). അല്ലാഹുവാകട്ടെ, എല്ലാ കാര്യത്തിനും ദൃക്‌സാക്ഷിയാണ് താനും."
  ],
  [
    10,
    "നിശ്ചയമായും, വിശ്വാസികളെയും വിശ്വാസിനികളെയും വിഷമിപ്പിക്കുകയും, പിന്നീട് പശ്ചാത്തപിക്കാതിരിക്കുകയും ചെയ്തവര്‍- അവര്‍ക്ക് നരകശിക്ഷയുണ്ട്, അവര്‍ക്ക് ചുട്ടെരിക്കുന്ന ശിക്ഷയുമുണ്ട്."
  ],
  [
    11,
    "നിശ്ചയമായും, വിശ്വസിക്കുകയും സല്‍കര്‍മ്മങ്ങള്‍ പ്രവര്‍ത്തിക്കുകയും ചെയ്തവരാകട്ടെ,- അവര്‍ക്ക് അടിഭാഗത്തിലൂടെ ആറുകള്‍ ഒഴുകുന്ന സ്വര്‍ഗ്ഗങ്ങളുണ്ട്. അതാണ് വലിയ വിജയം."
  ],
  [
    12,
    "നിശ്ചയമായും നിന്റെ റബ്ബിന്റെ പിടുത്തം (=ശിക്ഷ) കഠിനമായത് തന്നെയാണ്."
  ],
  [
    13,
    "നിശ്ചയമായും, അവന്‍ തന്നെയാണ് ആദ്യമായുണ്ടാക്കുന്നത്; ആവര്‍ത്തി(ച്ചുണ്ടാ)ക്കുന്നതും."
  ],
  [
    14,
    "അവന്‍ വളരെയേറെ പൊറുക്കുന്നവനും വളരെയേറെ സ്‌നേഹമുള്ളവനുമാണ്,"
  ],
  [
    15,
    "\"അര്‍ശ്\" (=സിംഹാസനം) ഉള്ളവനാണ്; മഹത്വമേറിയവനാണ്,"
  ],
  [
    16,
    "അവനുദ്ദേശിക്കുന്നതെന്തോ, അത് ശരിക്കും ചെയ്യുന്നവന്‍."
  ],
  [
    17,
    "ആ സൈന്യങ്ങളുടെ വര്‍ത്തമാനം നിനക്ക് വന്നുകിട്ടിയിട്ടുണ്ടോ?"
  ],
  [
    18,
    "(അതായത്) ഫിര്‍ഔനിന്റെയും സമൂദിന്റെയും (സൈന്യങ്ങളുടെ)?"
  ],
  [
    19,
    "എന്നാല്‍, സത്യനിഷേധികള്‍ കളവാക്കലിലാണുള്ളത്;"
  ],
  [
    20,
    "അല്ലാഹുവാകട്ടെ, അവരെ അവരുടെ പിന്നിലൂടെ വലയം ചെയ്തുകൊണ്ടിരിക്കുന്നവനാണ്."
  ],
  [
    21,
    "എന്നാല്‍, ഇത് മഹത്വമേറിയ ഒരു \"ഖുര്‍ആന്‍\" ആകുന്നു;"
  ],
  [
    22,
    "സൂക്ഷിക്കപ്പെട്ട (=സുരക്ഷിതമായ) ഒരു ഫലകത്തില്‍ (ഉള്ള ഖുര്‍ആന്‍)."
  ]
]