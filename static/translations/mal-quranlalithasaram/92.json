[
  {
    "id": 92,
    "city": "makkah",
    "name": {
      "translated": "The Night",
      "transliterated": "Al-Layl",
      "codepoints": [
        1575,
        1604,
        1604,
        1610,
        1604
      ]
    },
    "ayahs": 21,
    "slug": "al-layl",
    "translator": "Muhammad Karakunnu And Vanidas Elayavoor"
  },
  [
    1,
    "രാത്രി മൂടിക്കൊണ്ടിരിക്കുമ്പോള്‍ അതിനെ തന്നെ സത്യം,"
  ],
  [
    2,
    "പകല്‍ പ്രത്യക്ഷപ്പെടുമ്പോള്‍ അതിനെ തന്നെ സത്യം,"
  ],
  [
    3,
    "ആണിനെയും പെണ്ണിനെയും സൃഷ്ടിച്ചതിനെ (=ആ ശക്തിയെ) തന്നെയാണ സത്യം,"
  ],
  [
    4,
    "നിശ്ചയമായും, നിങ്ങളുടെ പരിശ്രമം വിഭിന്നമായിരിക്കും."
  ],
  [
    5,
    "അപ്പോള്‍ ആര്‍ ധനം കൊടുക്കുകയും (അല്ലാഹുവിനെ) സൂക്ഷി(ച്ചു ജീവി)ക്കുകയും ചെയ്തുവോ;"
  ],
  [
    6,
    "ഏറ്റവും നല്ലതില്‍ വിശ്വസിക്കുകയും ചെയ്തുവോ,"
  ],
  [
    7,
    "അവന്ന് നാം സുഗമമായത് എളുപ്പമാക്കിക്കൊടുക്കും."
  ],
  [
    8,
    "എന്നാല്‍, ആര്‍ (ധനം നല്‍കുന്നതില്‍) പിശുക്ക് കാണിക്കുകയും സ്വയം പര്യാപ്തനായി നടിക്കുകയും ചെയ്തു(വോ),"
  ],
  [
    9,
    "ഏറ്റവും നല്ലതിനെ നിഷേധിക്കുകയും ചെയ്തു(വോ),"
  ],
  [
    10,
    "അവന്ന് നാം പ്രയാസകരമായതിലേക്ക് സൗകര്യപ്പെടുത്തും (=അതിന്റെ മാര്‍ഗ്ഗത്തിലാക്കും)."
  ],
  [
    11,
    "അവന്‍ മറിഞ്ഞു വീണു കഴിഞ്ഞാല്‍ (=മരിച്ചു കഴിഞ്ഞാല്‍) അവന്റെ ധനം പിന്നെ അവന്ന് പ്രയോജനപ്പെടുന്നതുമല്ല."
  ],
  [
    12,
    "നിശ്ചയമായും, നമ്മുടെ ബാധ്യതയാണ് മാര്‍ഗ്ഗദര്‍ശനം നല്‍കല്‍;"
  ],
  [
    13,
    "നിശ്ചയമായും നമ്മുടേത് തന്നെയാണ് പരലോകവും ഇഹലോകവും."
  ],
  [
    14,
    "അതിനാല്‍ ആളിക്കത്തുന്ന അഗ്നിയെ കുറിച്ചു ഞാന്‍ നിങ്ങള്‍ക്ക് താക്കീത് നല്‍കിയിരിക്കുന്നു."
  ],
  [
    15,
    "ഏറ്റവും വലിയ നിര്‍ഭാഗ്യവാനല്ലാതെ അതില്‍ പ്രവേശിക്കുന്നതല്ല;"
  ],
  [
    16,
    "അതായത്, നിഷേധിക്കുകയും തിരിഞ്ഞുകളയുകയും ചെയ്തവന്‍."
  ],
  [
    17,
    "നല്ല സൂക്ഷ്മതയുള്ളവന്‍ അതില്‍ നിന്നകറ്റി നിര്‍ത്തപ്പെടും."
  ],
  [
    18,
    "അതായത്, സ്വയം പരിശുദ്ധി നേടാനായി തന്റെ ധനം കൊടുക്കുന്നവന്‍."
  ],
  [
    19,
    "പ്രത്യുപകാരം നല്‍കപ്പെടേണ്ടതായ ഒരനുഗ്രഹവും അവന്റെ പക്കല്‍ ആര്‍ക്കുമില്ല,-"
  ],
  [
    20,
    "അത്യുന്നതനായ തന്റെ റബ്ബിന്റെ മുഖം (=പ്രീതി) കാംക്ഷിക്കലല്ലാതെ."
  ],
  [
    21,
    "അവന്‍ തൃപ്തിയടയുക തന്നെ ചെയ്യും."
  ]
]