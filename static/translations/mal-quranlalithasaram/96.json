[
  {
    "id": 96,
    "city": "makkah",
    "name": {
      "translated": "The Clot",
      "transliterated": "Al-'Alaq",
      "codepoints": [
        1575,
        1604,
        1593,
        1604,
        1602
      ]
    },
    "ayahs": 19,
    "slug": "al-alaq",
    "translator": "Muhammad Karakunnu And Vanidas Elayavoor"
  },
  [
    1,
    "സൃഷ്ടിച്ചവനായ നിന്റെ റബ്ബിന്റെ നാമത്തില്‍ വായിക്കുക."
  ],
  [
    2,
    "മനുഷ്യനെ അവന്‍ ഒരു ഒട്ടി നില്‍ക്കുന്ന പിണ്ഡത്തില്‍ നിന്നും സൃഷ്ടിച്ചു."
  ],
  [
    3,
    "വായിക്കുക, നിന്റെ റബ്ബ് ഏറ്റവും ഉദാരനാകുന്നു."
  ],
  [
    4,
    "അതെ, പേനകൊണ്ട് പഠിപ്പിച്ചവന്‍;"
  ],
  [
    5,
    "അവന്‍ (=അല്ലാഹു) മനുഷ്യന് അറിഞ്ഞുകൂടാത്തത് അവന്ന് പഠിപ്പിച്ചു."
  ],
  [
    6,
    "അല്ല, നിശ്ചയമായും മനുഷ്യന്‍ അതിരുകവിഞ്ഞു പോകുന്നു;-"
  ],
  [
    7,
    "അവന്‍ സ്വയം ധന്യനായി (=സ്വയം പര്യാപ്തനായി) തന്നെ കണ്ടെത്തിയതിനാല്‍ (ആണിത്)."
  ],
  [
    8,
    "നിശ്ചയമായും നിന്റെ റബ്ബിങ്കലേക്ക് തന്നെയാണ് മടക്കം."
  ],
  [
    9,
    "വിലക്കുന്നവനെ നീ കണ്ടുവോ-"
  ],
  [
    10,
    "ഒരടിമയെ, അവന്‍ നമസ്‌കരിക്കുമ്പോള്‍ (വിലക്കുന്നവനെ)?"
  ],
  [
    11,
    "നീ കണ്ടുവോ, അവന്‍ (=ആ നമസ്‌കരിക്കുന്നവന്‍) നേര്‍മാര്‍ഗ്ഗത്തിലായിരുന്നുവെങ്കില്‍!"
  ],
  [
    12,
    "അല്ലെങ്കില്‍, അവന്‍ സൂക്ഷ്മത പാലിക്കുന്നതിനെപ്പറ്റി ആജ്ഞാപിക്കുന്നവനായിരുന്നുവെങ്കില്‍! (അപ്പോള്‍ ആ വിലക്കല്‍ എത്ര അപകടമായിരിക്കും!)"
  ],
  [
    13,
    "നീ കണ്ടുവോ, അവന്‍ (=ആ വിലക്കുന്നവന്‍) നിഷേധിക്കുകയും തിരിഞ്ഞുകളയുകയും ചെയ്തിരിക്കുകയാണ് എങ്കില്‍! (അപ്പോള്‍ ആ വിലക്കല്‍ എത്ര അപകടകരം)!"
  ],
  [
    14,
    "അവന്‍ അറിഞ്ഞിട്ടില്ലെ, അല്ലാഹു കാണുന്നുണ്ട് എന്ന്?"
  ],
  [
    15,
    "അല്ല, അവന്‍ വിരമിച്ചില്ലെങ്കില്‍, (അവന്റെ) മുന്‍കുടുമ നാം ഊക്കോടെ പിടിച്ചുവലിക്കും;"
  ],
  [
    16,
    "(അതെ,) കള്ളവാദിയും കുറ്റക്കാരിയുമായ (ആ) മുന്‍കുടുമ!"
  ],
  [
    17,
    "അതിനാല്‍, അവന്‍ അവന്റെ സഭയെ (=സഭക്കാരെ) വിളിച്ചുകൊള്ളട്ടെ!"
  ],
  [
    18,
    "നാം സബാനിയാക്കളെ (=നരകത്തിന്റെ മലക്കുകളെ)യും വിളിക്കുന്നതാണ്;"
  ],
  [
    19,
    "വേണ്ട, നീ അവനെ അനുസരിക്കരുത്; നീ സുജൂദ് ചെയ്യുക, (അല്ലാഹുവിനോട്) സാമീപ്യം നേടുകയും ചെയ്യുക."
  ]
]